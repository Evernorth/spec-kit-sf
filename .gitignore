*.session.sql

# Spec-kit runtime cache, logs & local registry (must not be committed)
.specify/extensions/.cache/
.specify/extensions/.backup/
.specify/extensions/*/*.local.yml
.specify/extensions/.registry
.specify/logs/
.specify/specs/*/test-logs/

